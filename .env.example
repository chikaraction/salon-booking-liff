# 環境ごとに変わる値はすべて環境変数に置く(ADR-007)
# このファイルを .env.local にコピーして実際の値を設定する(ローカル開発用)
#
# 本番(Cloudflare Workers)では .env ファイルを使わず、Cloudflare の画面に入れる
# (README「デプロイ」)。各変数の [ビルド時] [実行時] が置き場所:
#   [ビルド時] Settings → Build → Build variables and secrets
#              NEXT_PUBLIC_* はビルド時にコードへ埋め込まれる。変えたら再ビルドが必要
#   [実行時]   Settings → Variables and Secrets(秘密は Secret 型にする)

# --- Supabase(プロジェクト設定 > API から取得) ---
# [ビルド時]
NEXT_PUBLIC_SUPABASE_URL=
# [ビルド時]
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [実行時・Secret] サーバー専用。クライアントに露出させないこと(RLSをバイパスする)
SUPABASE_SERVICE_ROLE_KEY=

# --- LINE(LINE Developersコンソールから取得) ---
# [ビルド時] LIFFアプリのID。エンドポイントURLはサイトのルート(/)
NEXT_PUBLIC_LIFF_ID=
# LIFFが属するLINEログインチャネルのID(IDトークン検証のclient_idに使用)
# [実行時]
LINE_LOGIN_CHANNEL_ID=
# --- LINE Messaging API(M5の通知。公式アカウントの Messaging API チャネルから取得) ---
# [実行時・Secret] チャネルシークレット(チャネル基本設定)。Webhook の署名検証に使う
LINE_CHANNEL_SECRET=
# [実行時・Secret] 長期のチャネルアクセストークン(Messaging API設定)。
# 予約確認の応答メッセージ・前日リマインドのプッシュの送信に使う
LINE_CHANNEL_ACCESS_TOKEN=

# --- Cron(M5 前日リマインド) ---
# [実行時・Secret] /api/cron/reminders の保護。毎時0分の Cron(worker.ts の scheduled)が
# Authorization: Bearer {この値} を付けて呼び、一致しなければ 401 になる。ランダムな長い文字列にする
# 生成の例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=

# --- 開発用 ---
# 1のときLIFF SDKを使わずスタブのIDトークンで動作する(通常ブラウザでの
# スモークテスト用。開発時のみ1にする)
# 本番では設定しない: Cloudflare のビルドでは npm run build:cloudflare の
# デプロイ前チェックが、値が入っていればビルドを止める
NEXT_PUBLIC_LIFF_STUB=
