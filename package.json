    "@supabase/supabase-js": "^2.110.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "japanese-holidays": "^1.0.10",
    "lucide-react": "^1.24.0",
    "next": "16.4.2",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
