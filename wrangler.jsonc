// Cloudflare Workers の設定(M6。docs/milestone-6-plan.md)。
// テンプレート: node_modules/@opennextjs/cloudflare/templates/wrangler.jsonc
// - name は店名を含まない汎用名(ADR-007。2店舗目は別の Cloudflare アカウントに同じ名前で置く)
// - 全ページが動的(ルートレイアウトの connection())で ISR/SSG を使わないので、
//   テンプレートの R2 キャッシュ・WORKER_SELF_REFERENCE・images は入れない
//   (open-next.config.ts は既定の dummy キャッシュ)
// - 環境変数・シークレットはここに書かない(Cloudflare の画面で設定する)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salon-booking-liff",
  // OpenNext の生成物(.open-next/worker.js)に Cron 用の scheduled を足したカスタムワーカー(M5)
  "main": "worker.ts",
  // インストール済みの workerd(1.20261019.1)が対応する日付
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // 実行時の変数(LINE_LOGIN_CHANNEL_ID など Text のもの)は Cloudflare の画面で設定する。
  // 既定の wrangler deploy は画面で設定した vars を削除するので残す(Secret はもともと消えない)
  // (node_modules/wrangler/config-schema.json の keep_vars)
  "keep_vars": true,
  // Workers Logs(console.error と未捕捉の例外をダッシュボードの Observability で見られる)。
  // 本番だけで起きるエラーの中身を調べるために常時有効にする。無料プランは
  // 1日20万件・保持3日(https://developers.cloudflare.com/workers/observability/logs/workers-logs/)
  "observability": {
    "enabled": true,
  },
  // 前日リマインド(M5)の Cron Triggers。毎時0分に worker.ts の scheduled が呼ばれる。
  // Cron は UTC 指定だが、毎時なので JST とずれない。送るかどうか(店舗設定の送信時刻〜21時台)は
  // src/server/reminders.ts(判断は src/lib/reminders.ts)が決める。
  // 無料プランは Cron Triggers 5個/アカウント
  // (https://developers.cloudflare.com/workers/configuration/cron-triggers/ ・
  //  https://developers.cloudflare.com/workers/platform/limits/)
  "triggers": {
    "crons": ["0 * * * *"],
  },
}
